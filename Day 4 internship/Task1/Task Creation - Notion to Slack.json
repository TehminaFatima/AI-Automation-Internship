        "jsCode": "const sanitize = (str) =>\n  String(str)\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9\\s-]/g, '')\n    .replace(/\\s+/g, '-')\n    .replace(/-+/g, '-')\n    .replace(/^-|-$/g, '')\n    .slice(0, 80)\n    .replace(/-$/, '');\n\nreturn $input.all().map(item => {\n  return {\n    json: {\n      ...item.json,\n      channelName: sanitize(item.json.channelName)\n    }\n  };\n});"
      },
