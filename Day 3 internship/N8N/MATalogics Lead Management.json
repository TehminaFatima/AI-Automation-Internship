    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst errors = [];\n\nconst name = (body.name || '').toString().trim();\nconst email = (body.email || '').toString().trim();\nconst phone = (body.phone || '').toString().trim();\nconst company = (body.company || '').toString().trim();\nconst interest = (body.interest || '').toString().trim();\n\nif (!name) errors.push('name is required');\nif (!email) errors.push('email is required');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('email format is invalid');\nif (!phone) errors.push('phone is required');\nelse if (!/^\\+?[0-9]{10,15}$/.test(phone)) errors.push('phone format is invalid');\nif (!company) errors.push('company is required');\nif (!interest) errors.push('interest is required');\n\nif (errors.length > 0) {\n  return [{ json: { isValid: false, errors } }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    name,\n    email,\n    phone,\n    company,\n    interest,\n    createdAt: new Date().toISOString()\n  }\n}];"
      },
